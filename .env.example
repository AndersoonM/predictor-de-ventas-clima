# Copiar a .env (el script scripts/setup-floci.* lo hace solo). NO subir .env a GitHub.
# Prioridad al ejecutar: variables del sistema > .env > valores por defecto de application.yml

# --- Floci (emulador de AWS) ---
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# --- Base de datos (RDS PostgreSQL dentro de Floci) ---
DB_INSTANCE_ID=weather-sales-db
DB_HOST=localhost
DB_PORT=7001
DB_NAME=weathersales
DB_USER=ws_admin
DB_PASSWORD=ws_pass_2026

# --- Backend ---
SERVER_PORT=8080
